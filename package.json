{
  "name": "dvwa-nodejs",
  "version": "2.1.0",
  "private": true,
  "description": "DVWA NodeJS - a real Node.js shop (NodeBazaar) that is intentionally full of security bugs, for training and security tooling research. Node.js port of DVWA.",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "mocks": "node mocks/serve.js",
    "test": "node --test tests/*.test.js",
    "verify:fixes": "node scripts/verify-fix.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.12.0",
    "morgan": "^1.10.0",
    "pg": "^8.13.1"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}