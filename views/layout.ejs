<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title : 'NodeBazaar' %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<nav class="nav">
  <a class="brand" href="/">Node<b>Bazaar</b></a>
  <form class="searchbox" action="/search" method="get">
    <input type="search" name="q" placeholder="Search products…" value="<%= typeof q !== 'undefined' && q ? q : '' %>" aria-label="Search">
  </form>
  <div class="links">
    <% if (typeof logged !== 'undefined' && logged) { %>
      <a href="/orders">Orders</a>
      <a href="/tools">Tools</a>
      <a href="/account">Account</a>
      <span class="who"><%= username %></span>
      <a href="/logout">Log out</a>
    <% } else { %>
      <a href="/login">Log in</a>
      <a href="/register">Register</a>
    <% } %>
  </div>
</nav>
<main class="container">
<%- body %>
</main>
<footer class="footer">
  NodeBazaar — intentionally vulnerable Node.js shop. Local use only.
</footer>
<script src="/js/app.js"></script>
</body>
</html>