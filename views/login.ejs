<h1>Log in</h1>
<% if (typeof error !== 'undefined' && error) { %><p class="error-box"><%= error %></p><% } %>
<form method="post" action="/login/auth" class="form narrow">
  <input type="hidden" name="returnurl" value="<%= typeof returnurl !== 'undefined' ? returnurl : '' %>">
  <label>Username <input name="username" autofocus required></label>
  <label>Password <input name="password" type="password" required></label>
  <button type="submit">Log in</button>
</form>
<p class="muted">Demo accounts: alice/alice123 · bob/bob123 · admin/admin123</p>
<p class="muted">No account? <a href="/register">Register</a>.</p>